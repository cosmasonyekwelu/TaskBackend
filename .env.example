# Environment
NODE_ENV=development
PORT=3000

# Database
MONGODB_URI=mongodb://localhost:27017/taskbackend_db

# JWT Authentication
JWT_ACCESS_SECRET=replace-with-a-very-long-random-secret-32-plus-chars
JWT_ACCESS_EXPIRES_IN=24h
JWT_ISSUER=taskbackend
JWT_AUDIENCE=taskbackend-clients

# Security
BCRYPT_ROUNDS=12
JSON_LIMIT=1mb

# Rate Limiting
RATE_LIMIT_WINDOW_MINUTES=20
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=20

# CORS (comma-separated list in production)
CORS_ORIGIN=http://localhost:3000

# Observability
LOG_LEVEL=info
